# Copy this file to `.env` and fill in real values.
# `.env` is in .gitignore and must never be committed.

# PostgreSQL connection string from Neon (or any Postgres provider)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Random long string used to sign admin session cookies
SESSION_SECRET=change_this_to_a_long_random_string

# First admin account (created by `npm run init-db`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_on_first_run

# Port the web server will listen on
PORT=3000
